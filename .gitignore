# Generated disk artifacts — never commit these.
# Everything here is reproducible from tools/image/build.sh and
# tools/image/build-snapshot.sh; see README.md#rebuilding-generated-files.

# The raw Debian disk image (~745 MB)
images/debian.img

# All disk chunks: 40,960 files, plus the manifest and the per-build dirs
images/debian-chunks/

# Machine state (snapshot) and the boot fallback artifacts
images/debian-state.bin
images/debian-state.bin.zst
images/debian-bzImage
images/debian-initrd

# Content hash of the served build; regenerated by tools/image/build-id.js
images/build-id.json

# Offline pack lists and the service-worker precache list
packs/
chunks-precache.json

# Deploy staging directories
.deploy-pages/
.deploy-r2/
.build/

# Build/scratch output
*.log
__pycache__/
*.pyc

# OS and editor noise
.DS_Store
Thumbs.db
*.swp

# Assistant/tooling state, not part of the project
.commandcode/

# Wrangler's local cache: contains the account id and email, never commit it
.wrangler/

# Session audit notes — local only, not part of the project
HANDOFF.md

# Local environment / secrets (none are used by this project, but never commit them)
.env
.env.*
