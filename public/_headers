# Cloudflare Worker Static Assets headers for GoLinux.
#
# Rules are applied in file order. A later block that sets the same header
# REPLACES the earlier one only if the earlier one is detached with "!";
# otherwise the values are joined and conflicting directives break caching.
# Every narrow rule below detaches Cache-Control with "! Cache-Control" first.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  # The app shell must be revalidated every visit, or a deploy will not be
  # picked up until the browser cache expires.
  Cache-Control: public, max-age=0, must-revalidate

/terminal.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://assets.golinux.app https://cloudflare-dns.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'

# The service worker itself must never be cached, or clients keep an old worker.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

# Build id must never be cached: it is how the page notices that the shipped
# image changed and a saved user state is no longer compatible.
/images/build-id.json
  ! Cache-Control
  Cache-Control: no-store

# The snapshot changes on snapshot rebuilds: revalidate immediately so updates
# ship cleanly (SW caches it in versioned GL_DATA_CACHE for offline/repeat loads).
/images/debian-state.bin.zst
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/zstd

# v86 reads this as a byte stream; the type must be exact or instantiate fails.
/assets/v86/v86.wasm
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

/assets/v86/v86-fallback.wasm
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

# Vendored libraries: safe to pin forever only if renamed on upgrade, or bump
# GL_VERSION in packs-config.js so the SW cache invalidates.
/assets/v86/libv86.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/xterm/xterm.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/xterm/xterm.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/bios/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

# Kernel and initrd are only used for the cold-boot fallback; revalidate
# immediately so image rebuilds never serve stale kernels from HTTP disk cache.
/images/debian-bzImage
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/octet-stream

/images/debian-initrd
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/octet-stream

# Packs are NOT served from here. `packs/` is excluded from the deploy (see
# tools/deploy/build-pages.sh) and lives on R2 at assets.golinux.app.
/packs/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/json

# Next.js content-hashed static bundles (CSS, JS, self-hosted fonts) for landing page.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Extensionless OpenGraph / Twitter preview images emitted by Next.js metadata routes.
/opengraph-image
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: image/png

/twitter-image
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: image/png
