{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://golinux.app",
          "https://www.golinux.app",
          "https://terminal.golinux.app"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match", "If-Modified-Since"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
