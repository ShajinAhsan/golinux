# Minimal Linux 6.12 LTS x86_32 config for GoLinux v86 WebAssembly VM.
# Applied on top of `make ARCH=x86 tinyconfig` via merge_config.sh.
# Goals: ~1.5-2.0 MiB bzImage, ~4-6 MiB guest kernel RAM, zero modules/initrd,
#        no SMP locks, no Spectre/Meltdown PTI syscalls, tickless 100 Hz idle.

CONFIG_EXPERT=y
CONFIG_64BIT=n
CONFIG_X86_32=y
CONFIG_M686=y
CONFIG_NOHIGHMEM=y
CONFIG_MMU=y
CONFIG_X86_TSC=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_SMP=n
CONFIG_PREEMPT_NONE=y
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Disable CPU speculation / PTI mitigations (safe in browser WASM VM, huge syscall speedup)
CONFIG_MITIGATIONS=n
CONFIG_PAGE_TABLE_ISOLATION=n
CONFIG_RETPOLINE=n
CONFIG_SPECULATION_MITIGATIONS=n

# Strip kernel bloat, modules, and initrd
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_COREDUMP=n
CONFIG_ELF_CORE=n
CONFIG_BUG=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK_TIME=n
CONFIG_AUDIT=n
CONFIG_SECURITY=n
CONFIG_BPF_SYSCALL=n
CONFIG_IO_URING=n
CONFIG_PROFILING=n
CONFIG_FTRACE=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_PARAVIRT=n

# Core kernel features needed by Alpine / BusyBox / tcc / python3 / git / tmux / htop
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=n
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y
CONFIG_FILE_LOCKING=y
CONFIG_FSNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Block & partitions
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y

# Exact v86 PCI / IDE / VirtIO / Serial devices built in (=y)
CONFIG_PCI=y
CONFIG_PCI_GOANY=y
CONFIG_PCI_BIOS=y
CONFIG_PCI_DIRECT=y
CONFIG_PCI_MSI=y
CONFIG_X86_UP_APIC=y
CONFIG_X86_UP_IOAPIC=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_HVC_DRIVER=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NET_9P_DEBUG=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Filesystems (SquashFS + OverlayFS + 9P + Ext4 fallback)
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=n
CONFIG_SQUASHFS_ZSTD=n
CONFIG_SQUASHFS_FRAGMENT_CACHE_SIZE=3
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_NFS_FS=n
CONFIG_CIFS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n

# Lean IPv4 networking (no IPv6/Netfilter/Wireless overhead)
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=n
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_NETFILTER=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_RFKILL=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n

# Explicitly disabled subsystems
CONFIG_ACPI=n
CONFIG_PM=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_USB_SUPPORT=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_HID=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_MD=n
CONFIG_BLK_DEV_DM=n
CONFIG_NVME_CORE=n
CONFIG_BLK_DEV_NVME=n
